{
  "name": "fateh-maintenance-portal",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "format": "prettier --write src vite.config.ts scripts README.md",
    "format:check": "prettier --check src vite.config.ts scripts README.md"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "@tanstack/react-query": "5.105.1",
    "i18next": "26.7.1",
    "jszip": "3.10.2",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.11",
    "react-router-dom": "7.18.5"
  },
  "devDependencies": {
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "optionalDependencies": {
    "@rolldown/binding-win32-x64-msvc": "1.2.16"
  }
